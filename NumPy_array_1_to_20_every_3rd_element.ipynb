      "source": [
        "import numpy as np\n",
        "\n",
        "# Create a NumPy array containing numbers from 1 to 20\n",
        "arr = np.arange(1, 21)\n",
        "\n",
        "# Select every 3rd element, starting from the 2nd element\n",
        "new_arr = arr[1::3]\n",
        "\n",
        "print(\"Original array:\", arr)\n",
        "print(\"New array:\", new_arr)"
      ]
    }
